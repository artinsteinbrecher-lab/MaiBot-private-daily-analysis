{
  "manifest_version": 2,
  "id": "khiqwq.daily_analysis",
  "version": "3.3.1",
  "plugin_type": "tool",
  "name": "私聊群事件日报",
  "description": "按白名单完整或抽样读取 QQ 群聊天记录，先生成轻量话题时间线，再精炼主要事件，并仅发送给指定管理员私聊。支持分段重试、主要事件详情、普通话题时间戳和次日定时日报。",
  "author": {
    "name": "artinsteinbrecher-lab",
    "url": "https://github.com/artinsteinbrecher-lab"
  },
  "license": "GPL-3.0-or-later",
  "urls": {
    "repository": "https://github.com/artinsteinbrecher-lab/MaiBot-private-daily-analysis",
    "homepage": "https://github.com/artinsteinbrecher-lab/MaiBot-private-daily-analysis",
    "documentation": "https://docs.mai-mai.org/plugin/",
    "issues": "https://github.com/artinsteinbrecher-lab/MaiBot-private-daily-analysis/issues"
  },
  "host_application": {
    "min_version": "1.0.0",
    "max_version": "1.99.99"
  },
  "sdk": {
    "min_version": "2.0.0",
    "max_version": "2.99.99"
  },
  "dependencies": [
    {
      "type": "python_package",
      "name": "jinja2",
      "version_spec": ">=3.1.0"
    }
  ],
  "capabilities": [
    "send.text",
    "send.image",
    "llm.generate",
    "llm.get_available_models",
    "config.get",
    "message.get_by_time_in_chat",
    "chat.get_group_streams",
    "chat.open_session",
    "render.html2png",
    "maisaka.context.append"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  }
}
